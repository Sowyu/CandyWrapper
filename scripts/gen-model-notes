#!/usr/bin/env python3
"""Write the model notes snapshot Redesign's model picker reads: per model, models.dev's one-line description, context
window, knowledge cutoff, input types and its own provider's price.

Run it at release time, never from the app: the picker reads only the generated file and makes no request.
    scripts/gen-model-notes              # fetches https://models.dev/api.json
    scripts/gen-model-notes api.json     # uses a saved copy
The request carries nothing about the user or the project. models.dev is MIT licensed
(github.com/anomalyco/models.dev); the licences page credits it through scripts/gen-settings-native-licenses.py.
"""
import datetime
import json
import sys
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / 'Packages/CandyKit/Sources/Features/Pickers/ModelNotesSnapshot.swift'
URL = 'https://models.dev/api.json'
# The labs whose own rows T3's drivers use, plus OpenCode's own models (`opencode/<model>` slugs).
PROVIDERS = ['anthropic', 'openai', 'google', 'xai', 'deepseek', 'mistral', 'moonshotai', 'zai', 'alibaba', 'minimax',
             'meta', 'opencode']
MAX_DESCRIPTION = 120


def short(text):
    """The description cut to about 120 characters at a sentence end, else at a word, with an ellipsis."""
    text = ' '.join((text or '').split())
    if len(text) <= MAX_DESCRIPTION:
        return text
    head = text[:MAX_DESCRIPTION + 1]
    end = max(head.rfind('. '), head.rfind('! '), head.rfind('? '))
    if end >= 40:
        return head[:end + 1]
    return head[:head[:MAX_DESCRIPTION - 1].rfind(' ')].rstrip(',;:') + '…'


def main():
    if len(sys.argv) > 1:
        raw = Path(sys.argv[1]).read_bytes()
    else:
        req = urllib.request.Request(URL, headers={'User-Agent': 'gen-model-notes'})
        raw = urllib.request.urlopen(req, timeout=60).read()
    data = json.loads(raw)
    models = {}
    for provider in PROVIDERS:
        for mid, m in sorted(data.get(provider, {}).get('models', {}).items()):
            if 'text' not in m.get('modalities', {}).get('output', []) or not m.get('tool_call'):
                continue
            note = {'name': m.get('name') or mid}
            if m.get('description'):
                note['description'] = short(m['description'])
            limit = m.get('limit') or {}
            if limit.get('context'):
                note['context'] = int(limit['context'])
            if m.get('knowledge'):
                note['knowledge'] = m['knowledge']
            inputs = m.get('modalities', {}).get('input')
            if inputs:
                note['input'] = inputs
            cost = m.get('cost') or {}
            if 'input' in cost and 'output' in cost:
                note['price'] = {k: cost[k] for k in ('input', 'output', 'cache_read', 'cache_write') if k in cost}
            models[f'{provider}/{mid}'] = note
    snapshot = {
        'source': {'name': 'models.dev', 'url': 'https://models.dev', 'repository': 'https://github.com/anomalyco/models.dev',
                   'licence': 'MIT', 'fetched': datetime.date.today().isoformat()},
        'models': models,
    }
    body = json.dumps(snapshot, ensure_ascii=False, separators=(',', ':'), sort_keys=True)
    assert '"#' not in body
    OUT.write_text('// Generated by scripts/gen-model-notes from models.dev (MIT). Do not edit.\n'
                   'enum ModelNotesSnapshot {\n'
                   f'    static let json = #"{body}"#\n'
                   '}\n')
    print(f'{len(models)} models from models.dev, fetched {snapshot["source"]["fetched"]}, into {OUT.relative_to(ROOT)}')


if __name__ == '__main__':
    main()
