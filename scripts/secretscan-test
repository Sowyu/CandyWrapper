#!/bin/zsh -f
# Self-check for scripts/secretscan: plants each kind of leak in a throwaway repo and expects the scan
# to block it, and to pass clean commits and removals. Prints "ok", or each case that slipped through.
scan=${0:A:h}/secretscan
dir=$(mktemp -d /tmp/cw-scantest.XXXXXX) || exit 2
trap 'rm -rf $dir' EXIT
cd $dir && git init -q && git config user.name test && git config user.email 1+test@users.noreply.github.com
print 'zz-private-zz' > .git/info/secret-patterns
ip=$(/sbin/ifconfig | awk '/inet /{print $2}' | grep -v '^127\.' | head -1)
fail=0
# expect <exit status> <case>: scans the newest commit.
expect() { $scan HEAD~1..HEAD 2>/dev/null; local s=$?; (( s == $1 )) || { print "FAIL $2: exit $s, want $1"; fail=1 } }
add() { print -r -- "$1" >> f; git add f; git commit -q -m "${2:-change}" }
add base; add clean; expect 0 "clean commit"
add "token gh""p_abcdef"; expect 1 "GitHub token"
git rm -q f; git commit -q -m remove; expect 0 "removing a leak"
add "ZZ-PRIVATE-zz"; expect 1 "private pattern"
add "host $ip"; expect 1 "this Mac's IP address"
add more "fix"$'\n\n'"Co-Authored-By: Claude <noreply@anthropic.com>"; expect 1 "AI attribution"
git -c user.email=someone@example.com commit -q --allow-empty -m other; expect 1 "personal e-mail"
git -c user.email=anika@anikodev.org commit -q --allow-empty -m public; expect 0 "approved public e-mail"
(( fail )) || print ok
exit $fail
