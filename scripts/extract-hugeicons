#!/usr/bin/env python3
"""Generate IconDataHugeicons.generated.swift: Hugeicons stroke-rounded (MIT) as a duotone set for the Dither theme.

Usage: scripts/extract-hugeicons [--json PATH] [--out FILE]
  --json  Iconify JSON for the Hugeicons free set (icons.json)
  --out   output Swift file

Each lucide IconName maps to the closest Hugeicons glyph in LUCIDE_TO_HUGEICONS. Strokes get
width 1.8 (the source uses 1.5) with round caps and joins. Every closed stroked shape gets a
fill-only copy at 16% opacity drawn before it. Open subpaths (checks, arrows, lines) never fill.
The script reads the JSON as data only. It uses the Python standard library.
"""
import argparse
import json
import math
import os
import re
import sys
import xml.etree.ElementTree as ET

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_JSON = os.path.expanduser("~/CandyWrapper-research/downloads/packs/iconify/hugeicons/package/icons.json")
DEFAULT_OUT = os.path.join(ROOT, "Packages/CandyKit/Sources/DesignSystem/Icons/IconDataHugeicons.generated.swift")
ICON_DATA = os.path.join(ROOT, "Packages/CandyKit/Sources/DesignSystem/Icons/IconData.generated.swift")

STROKE_WIDTH = 1.8   # source is 1.5; the user wants them bolder
SOURCE_STROKE = 1.5
DUO_OPACITY = 0.16

# lucide name -> Hugeicons name. Lucide names left out have no good Hugeicons match and keep lucide.
