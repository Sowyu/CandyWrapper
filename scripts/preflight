#!/bin/zsh -f
# Exits 1 when building would eat disk the user needs: under 40 GB free, over 25 GB of task builds in /tmp,
# or over 30 GB in the warm slots. Warns while a Zen browser build (mach) runs, since both then build slower.
# Warm slots (scripts/warm-worktree: /tmp/cw-slot-N and /tmp/cw-dd-slot-N) count apart, about 4 GB each and
# at most six; they stay between tasks on purpose. They hold no APFS clones, so du counts them right.
# Run it before building and before launching agents. scripts/build-test-app runs it.
"$(dirname "$0")/wait-origin"
free=$(df -g /System/Volumes/Data | awk 'NR==2 {print $4}')
setopt extendedglob
slots=(/tmp/cw-(dd-|)slot-<->(N/))
ours=$(du -sk /tmp/cw-*~/tmp/cw-(dd-|)slot-<->*(N) /dev/null 2>/dev/null | awk '{s+=$1} END {printf "%d", s/1048576}')
warm=$(du -sk $slots /dev/null 2>/dev/null | awk '{s+=$1} END {printf "%d", s/1048576}')
mach=$(ps -axo command | grep -E '(^|/)mach (build|package)|/mach build' | grep -v grep | wc -l | tr -d ' ')
print "free ${free} GB, CandyWrapper builds in /tmp ${ours} GB, warm slots ${warm} GB, Zen builds running ${mach}"
(( mach )) && print "a Zen build is running: build one CandyWrapper app at a time"
(( free >= 40 )) || { print "under 40 GB free: don't build, tell the user"; exit 1 }
(( ours <= 25 )) || { print "over 25 GB in /tmp/cw-*: delete finished builds (your own /tmp/cw-dd-<task>) first"; exit 1 }
(( warm <= 30 )) || { print "over 30 GB in warm slots: free slots (scripts/warm-worktree --list) can go with git worktree remove and rm -rf /tmp/cw-dd-slot-N"; exit 1 }
