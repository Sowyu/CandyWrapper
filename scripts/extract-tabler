def fetch_pack():
    icons = os.path.join(PACK, "package/icons/outline")
    if os.path.isdir(icons):
        return icons
    os.makedirs(PACK, exist_ok=True)
    tgz = os.path.join(PACK, "tabler-icons-%s.tgz" % VERSION)
    req = urllib.request.Request(TARBALL, headers={"User-Agent": "npm-fetch"})
    data = urllib.request.urlopen(req, timeout=120).read()
    got = hashlib.sha256(data).hexdigest()
    if got != SHA256:
        sys.exit("tarball sha256 %s, expected %s" % (got, SHA256))
    with open(tgz, "wb") as f:
        f.write(data)
    with tarfile.open(tgz) as t:
        t.extractall(PACK, filter="data")
    return icons


def fmt(v):
    v = round(float(v), 3)
    return str(int(v)) if v == int(v) else ("%.3f" % v).rstrip("0").rstrip(".")


def compact(d):
    """Tabler writes `-.5` with a space before each sign; the app's parser takes the same numbers with less padding."""
    return re.sub(r"\s+", " ", d.strip())


def convert(path):
    root = ET.parse(path).getroot()
    out = []
    for el in root.iter():
        tag = el.tag.split("}")[-1]
        if tag == "svg":
            continue
        a = el.attrib
        if a.get("stroke") == "none" and a.get("fill") == "none":
            continue  # Tabler's 24x24 bounding box
        if set(a) - {"d", "cx", "cy", "r", "rx", "ry", "x", "y", "width", "height", "x1", "y1", "x2", "y2", "points", "fill",
                     "stroke-width"}:
            raise ValueError("unsupported attributes %s on <%s>" % (sorted(a), tag))
        if tag == "path":
            shape = '.path(d: "%s")' % compact(a["d"])
        elif tag == "circle":
            shape = ".circle(cx: %s, cy: %s, r: %s)" % (fmt(a["cx"]), fmt(a["cy"]), fmt(a["r"]))
        elif tag == "rect":
            rx = a.get("rx", a.get("ry", "0"))
            shape = ".rect(x: %s, y: %s, w: %s, h: %s, rx: %s, ry: %s)" % (
                fmt(a.get("x", 0)), fmt(a.get("y", 0)), fmt(a["width"]), fmt(a["height"]), fmt(rx), fmt(a.get("ry", rx)))
        elif tag == "line":
            shape = ".line(x1: %s, y1: %s, x2: %s, y2: %s)" % tuple(fmt(a[k]) for k in ("x1", "y1", "x2", "y2"))
        else:
            raise ValueError("unsupported <%s>" % tag)
        if a.get("fill") == "currentColor":
            out.append("IconElement(%s, IconPaint(fill: .current, stroke: .current, strokeWidth: 2, lineCap: .round, lineJoin: .round))" % shape)
        elif a.get("fill", "none") != "none" or "stroke-width" in a:
            raise ValueError("unsupported paint %s" % dict(a))
        else:
            out.append("IconElement(%s)" % shape)
    if not out:
        raise ValueError("no shapes")
    return out


def lucide_cases(path):
    src = open(path).read()
    return {m.group(2): m.group(1) for m in re.finditer(r'case \.(\w+): return "([a-z0-9-]+)"', src)}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--icons")
    ap.add_argument("--out", default=DEFAULT_OUT)
    args = ap.parse_args()
    icons = args.icons or fetch_pack()
    cases = lucide_cases(ICON_DATA)
    lines = [
        "// GENERATED by scripts/extract-tabler. Do not edit.",
        "// Tabler Icons %s outline (MIT, see LICENSE-tabler.txt), https://tabler.io/icons" % VERSION,
        "",
        "extension IconName {",
        "    /// Tabler glyph for this icon under Redesign; nil only for brand glyphs.",
        "    public var tablerDefinition: IconDefinition? {",
        "        switch self {",
    ]
    mapped, missing = 0, []
    for lucide, case in sorted(cases.items(), key=lambda kv: kv[1]):
        tabler = LUCIDE_TO_TABLER.get(lucide, lucide)
        svg = os.path.join(icons, tabler + ".svg")
        if not os.path.exists(svg):
            missing.append(lucide)
            continue
        elements = convert(svg)
        lines.append("        case .%s: // %s" % (case, tabler))
        lines.append("            return IconDefinition(viewBox: IconViewBox(x: 0, y: 0, width: 24, height: 24), elements: [")
        lines += ["                %s," % e for e in elements]
        lines.append("            ])")
        mapped += 1
    lines += ["        default:", "            return nil", "        }", "    }", "}", ""]
    if missing:
        sys.exit("no Tabler glyph for: %s. Map them in LUCIDE_TO_TABLER." % ", ".join(missing))
    stale = sorted(set(LUCIDE_TO_TABLER) - set(cases))
    if stale:
        sys.exit("LUCIDE_TO_TABLER names no lucide icon in IconName: %s" % ", ".join(stale))
    with open(args.out, "w") as f:
        f.write("\n".join(lines))
    print("mapped %d" % mapped)


if __name__ == "__main__":
    main()
