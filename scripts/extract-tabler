#!/usr/bin/env python3
"""Generate IconDataTabler.generated.swift: Tabler Icons outline (MIT) for the Redesign theme.

Usage: scripts/extract-tabler [--icons DIR] [--out FILE]
  --icons  the outline SVG folder of @tabler/icons 3.50.0 (package/icons/outline)
  --out    output Swift file

Without --icons it downloads the pinned npm tarball from registry.npmjs.org into
~/CandyWrapper-research/downloads/packs/tabler-icons-3.50.0 and checks its SHA-256.

Each lucide IconName maps to a Tabler glyph: the name in LUCIDE_TO_TABLER, else the same name when Tabler has it.
Every lucide icon must map, so Redesign draws only Tabler. Tabler outline icons are 24x24 with
stroke 2, round caps and joins, like lucide, so elements use IconPaint.lucide unless they set their own fill.
The script reads the SVGs as data only. It uses the Python standard library.
"""
import argparse
import hashlib
import os
import re
import sys
import tarfile
import urllib.request
import xml.etree.ElementTree as ET

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VERSION = "3.50.0"
TARBALL = "https://registry.npmjs.org/@tabler/icons/-/icons-%s.tgz" % VERSION
SHA256 = "4c2eb678ed71cdcbf57a3e899c4e91f3445d680fbc1d57d27c7083a321c47303"
PACK = os.path.expanduser("~/CandyWrapper-research/downloads/packs/tabler-icons-%s" % VERSION)
DEFAULT_OUT = os.path.join(ROOT, "Packages/CandyKit/Sources/DesignSystem/Icons/IconDataTabler.generated.swift")
ICON_DATA = os.path.join(ROOT, "Packages/CandyKit/Sources/DesignSystem/Icons/IconData.generated.swift")

# lucide name -> Tabler name where they differ, or where Tabler's same-name glyph is the wrong pick.
# The Settings nav and grid rows follow the set the user approved on 2026-11-21 (icon-sets-2026-11-21/tabler-*.png).
LUCIDE_TO_TABLER = {
