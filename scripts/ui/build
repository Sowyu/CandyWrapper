#!/bin/sh
# Builds the UI driving tools into /tmp/cw-ui: click, scroll, key, type, drag, move, winid, shot, record, axpress,
# front, grid, colmean. They post CGEvents, use the Accessibility API and ScreenCaptureKit, so the shell's
# responsible app (T3's `t3` here) needs Screen Recording and Accessibility ("Device Control and Data Access"
# on macOS 27). Coordinates are global screen points, top-left origin; screencapture -R uses the same space.
# Usage: scripts/ui/build [dir], default /tmp/cw-ui. Other agents use /tmp/cw-ui, so try a change to the
# tools in a folder of your own first.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
out="${1:-/tmp/cw-ui}"
mkdir -p "$out"
# The input tools get windows.swift and input-guard.swift in front: background input to CW_UI_PID, and no
# input while the user's demo app is frontmost. record also gets capture.swift.
for t in click scroll key type drag move; do
  cat "$here/windows.swift" "$here/input-guard.swift" "$here/$t.swift" > "$out/$t-main.swift"
  swiftc -O -o "$out/$t" "$out/$t-main.swift"
done
for t in winid shot; do
  cat "$here/windows.swift" "$here/$t.swift" > "$out/$t-main.swift"
  swiftc -O -o "$out/$t" "$out/$t-main.swift"
done
cat "$here/windows.swift" "$here/capture.swift" "$here/record.swift" > "$out/record-main.swift"
swiftc -O -o "$out/record" "$out/record-main.swift"
for t in axpress front grid colmean; do swiftc -O -o "$out/$t" "$here/$t.swift"; done
echo "built into $out"
