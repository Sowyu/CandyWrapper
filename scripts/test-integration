#!/bin/zsh
# Runs the opt-in tests that need a real `t3 serve`, the sandbox server (scripts/sandbox-server) or the
# login Keychain, one at a time, after any Origin energy run ends. The default suite reports them as
# skipped. Add CANDY_RUNTIME_INSTALL_TEST=/tmp/<folder> to also download and install a T3 runtime.
here="${0:A:h}"
"$here/wait-origin"
cd "$here/../Packages/CandyKit" && CW_INTEGRATION=1 exec swift test --no-parallel \
    --filter 'LocalServerIntegrationTests|SandboxIntegrationTests|CredentialStoreTests/saveLoadReplaceDelete|ClerkKeychainStoreTests/roundTripReplacesAndDeletes|RuntimeStoreTests/realInstallIntoATemporaryFolder' "$@"
