#!/bin/sh
# Starts an isolated T3 server for testing. Never touches ~/.t3/userdata.
# Usage: scripts/sandbox-server [runtime-version]
# For a second server, like the newer Nightly: SANDBOX_DIR=<dir> SANDBOX_PORT=<port> T3_BIN=<path to t3> scripts/sandbox-server
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
sandbox="$here/../CandyWrapper-research/sandbox"
# Worktrees that live elsewhere, like the ones T3 makes, use the research folder in the home folder.
[ -d "$sandbox" ] || sandbox="$HOME/CandyWrapper-research/sandbox"
sandbox="${SANDBOX_DIR:-$sandbox}"
port="${SANDBOX_PORT:-47391}"
version="${1:-$(cat "$here/T3_VERSION" | sed 's/^v//')}"
bin="$HOME/.t3/runtime/versions/$version/t3"
# A Nightly the live T3 hasn't installed comes unpacked from its GitHub release (docs/nightly-catch-up.md).
[ -x "$bin" ] || bin="$HOME/CandyWrapper-research/runtimes/t3-$version-darwin-arm64/t3"
bin="${T3_BIN:-$bin}"
mkdir -p "$sandbox/t3home"
if [ -f "$sandbox/server.pid" ] && kill -0 "$(cat "$sandbox/server.pid")" 2>/dev/null; then
  echo "sandbox server already running, pid $(cat "$sandbox/server.pid")"; exit 0
fi
# env -i: the shell inherits the live service's T3 variables, which would make
# this server try to attach to the live service launcher.
# Detach into a new session so harness time limits and shell exits don't kill it.
# (nohup fails here: there is no controlling terminal.)
/usr/bin/python3 - "$sandbox" "$bin" "$port" <<'PY'
import os, subprocess, sys
sandbox, binary, port = sys.argv[1], sys.argv[2], sys.argv[3]
env = {"HOME": os.environ["HOME"], "USER": os.environ.get("USER", "mrm"), "LOGNAME": os.environ.get("USER", "mrm"),
       "SHELL": "/bin/zsh", "LANG": "en_US.UTF-8", "TMPDIR": os.environ.get("TMPDIR", "/tmp"),
       "PATH": os.environ["HOME"] + "/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
       "T3CODE_TELEMETRY_ENABLED": "false", "T3CODE_HOME": sandbox + "/t3home"}
log = open(sandbox + "/server.log", "ab")
p = subprocess.Popen([binary, "serve", "--base-dir", sandbox + "/t3home", "--port", port, "--host", "127.0.0.1", "--no-browser"],
                     env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True, close_fds=True)
open(sandbox + "/server.pid", "w").write(str(p.pid))
PY
echo "sandbox server pid $(cat "$sandbox/server.pid"), http://127.0.0.1:$port, log $sandbox/server.log"
