#!/bin/zsh -f
# Checks SpaceKeyStore's login Keychain item in release-style signed builds (docs/space.md, "How agents are
# kept out"). Debug and test builds are ad hoc signed, so the ACL can't be checked in scripts/test.
#
# It signs a probe built from Sources/SpaceCrypto like scripts/release signs the app: Apple Development,
# Team 8Q677AYRU7, hardened runtime, no provisioning profile. Then, in the GUI user's security session with
# Keychain prompts off, the probe saves a synthetic key and checks that
#   - a fresh process of the same build reads it,
#   - a rebuilt binary with the same identity and identifier reads it, as an update would,
#   - the same team's other app identifier and an ad hoc copy with the same identifier are denied,
#   - saving a different key never replaces it,
# and deletes it. Exits 1 on any unexpected outcome.
set -euo pipefail
here=${0:A:h:h}
$here/scripts/preflight
IDENTITY="Apple Development"
TEAM=8Q677AYRU7
KC=$HOME/Library/Keychains/candywrapper-release.keychain-db
ID=dev.candywrapper.space-keychain-test
service=$ID.$(uuidgen)
out=$(mktemp -d /tmp/cw-space-keychain.XXXXXX)

run() { sudo launchctl asuser 502 sudo -u mrm $out/$1 $2 $service }
cleanup() {
  [[ -x $out/probe ]] && run probe delete >/dev/null 2>&1 || true
  security lock-keychain $KC 2>/dev/null || true
  rm -rf $out
}
trap cleanup EXIT

cp $here/scripts/space-keychain-probe.swift $out/main.swift
src=($here/Packages/CandyKit/Sources/SpaceCrypto/*.swift $out/main.swift)
# Two optimization levels give two different binaries, as an app update would be.
for opt bin in -O probe -Osize updated; do
  xcrun swiftc $opt -target arm64-apple-macos14.0 $src -o $out/$bin 2>$out/build.log || { cat $out/build.log >&2; exit 1 }
done
strip -x -S $out/probe $out/updated
cp $out/probe $out/other-app
cp $out/probe $out/ad-hoc

# Same unlock as scripts/release: the password goes through stdin, never argv.
pw=$(security find-generic-password -s dev.candywrapper.release-keychain -w)
print -r -- "unlock-keychain -p $pw $KC" | security -i >/dev/null
unset pw
sign() { codesign --force --sign $IDENTITY --options runtime --timestamp=none "$@" }
sign --identifier $ID $out/probe
sign --identifier $ID $out/updated
sign --identifier $ID.other $out/other-app
codesign --force --sign - --identifier $ID $out/ad-hoc
security lock-keychain $KC
for b in probe updated other-app; do
  codesign --verify --strict $out/$b
  [[ $(codesign -dv $out/$b 2>&1) == *$'\n'TeamIdentifier=$TEAM$'\n'* ]] || { print -u2 "$b: wrong team"; exit 1 }
done
[[ $(codesign -dv $out/probe 2>&1) != $(codesign -dv $out/updated 2>&1) ]] || { print -u2 "updated build is identical"; exit 1 }

failed=0
expect() { # binary mode pattern
  local got=$(run $1 $2)
  if [[ $got == ${~3} ]]; then print "ok   $1 $2: $got"; else print "FAIL $1 $2: $got, wanted $3"; failed=1; fi
}
expect probe save saved
expect probe read match
expect updated read match
expect other-app read 'keychain\(*'
expect ad-hoc read 'keychain\(*'
expect probe replace differentKeyStored
expect probe read match
expect probe delete deleted
expect probe read missing
exit $failed
