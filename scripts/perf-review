#!/usr/bin/python3
"""Repeatable performance review: build a Release app from one commit, run a fixed workload against
a private copy of the frozen perf dataset, save the numbers and compare them with earlier runs.

Usage:
  scripts/perf-review [--commit REV | --source DIR] [--baseline FILE] [--repeat N] [--stream]
                      [--idle-seconds S] [--no-bench] [--no-app] [--out-dir DIR] [--max-load L]
  scripts/perf-review --make-workload    copy the sandbox home into the pristine perf dataset (once)

  --commit REV   build REV (default HEAD) from its own worktree in /tmp/cw-perf/src-<sha>
  --source DIR   build a checkout as it is, uncommitted changes included (sha gets "-dirty")
  --baseline F   compare with this saved JSON instead of the newest other run in the out dir
  --stream       also measure one tiny claude-haiku-5-5 turn (costs a real turn on the user's plan)
  --repeat N     app launches per scenario (default 3); the report gives the median and the range

Writes <out-dir>/<date>-<sha>.json and .md (default docs/perf) and prints the comparison table.
Method, metrics and thresholds: docs/perf/README.md. Each run copies the pristine dataset (PRISTINE)
to a temporary home, starts its own T3 server on a free port, and deletes both at the end. It never
uses the shared sandbox server on 47391.
"""
import argparse
import datetime
import glob
import json
import os
import re
import shutil
import signal
import socket
import statistics
import subprocess
import sys
import time

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
WORK = "/tmp/cw-perf"
BIN = WORK + "/bin"
SANDBOX = os.path.normpath(os.path.join(REPO, "..", "CandyWrapper-research", "sandbox"))
# A worktree under .claude/worktrees still shares the research folder next to the main checkout.
if not os.path.isdir(SANDBOX):
    SANDBOX = "/Users/mrm/CandyWrapper-research/sandbox"
# The frozen workload. Bump WORKLOAD when the pristine dataset changes; runs compare only with runs
# of the same workload. Workload 1: the sandbox home as of 2026-10-10 12:55.
WORKLOAD = 1
PRISTINE = os.path.join(os.path.dirname(SANDBOX), "perf-home-pristine")
SERVER = None  # set by PerfServer.start
# The sandbox's session token; the pristine copy has the same auth tables, so it works there too.
TOKEN = SANDBOX + "/session.token"
# Compile and test processes (other agents); each scenario waits until none of them runs.
BUSY_PROCESSES = {"swift-frontend", "swift-build", "swiftc", "xcodebuild", "clang", "ld", "xctest", "swiftpm-testing-helper"}
PID_FILE = "/tmp/candywrapper-app.pid"
# Perf builds get their own bundle id, so their UserDefaults are a domain of their own, emptied before every
# launch: on 2026-10-10 a file tab an agent left open on the big thread (rightPanel.states.v1 in the shared
# dev.candywrapper.app domain) narrowed the timeline and read as a 30% scroll regression.
PERF_BUNDLE_ID = "dev.candywrapper.perf"
# The thread cache likewise: dev runs fill the shared one from the live sandbox, which has drifted from the
# frozen dataset. This one only ever sees the perf server, so after the first launch it is warm and stable.
PERF_THREAD_CACHE = os.path.join(os.path.dirname(SANDBOX), "perf-thread-cache-w%d" % WORKLOAD)
DEMO_PID_FILE = "/tmp/cw-demo.pid"
IDLE_THREAD = "Reply with one word: candy"
BIG_THREAD = "Numbers 1 to 1000"
STREAM_PROMPT = "Without using any tools, write the numbers from 1 to 60 as English words, one per line."

# Lower is better for every metric. A change counts as a regression (or an improvement) only when it
# passes both the relative and the absolute threshold, and, with 3 or more samples on each side, the
# two ranges don't overlap. (relative, absolute, unit)
THRESHOLDS = {
    "launch.window_ms": (0.15, 50, "ms"),
    "launch.cached_sidebar_ms": (0.15, 50, "ms"),
    "launch.live_sidebar_ms": (0.15, 50, "ms"),
    "idle.cpu_pct": (0.50, 0.05, "%"),
    "idle.interrupt_wakeups_per_s": (0.25, 1.0, "/s"),
    "idle.package_idle_wakeups_per_s": (0.25, 1.0, "/s"),
    "idle.footprint_mb": (0.10, 3, "MB"),
    "idle.peak_footprint_mb": (0.10, 5, "MB"),
    "big_thread.footprint_mb": (0.10, 3, "MB"),
    "big_thread.peak_footprint_mb": (0.10, 5, "MB"),
    "big_thread.scroll_cpu_ms": (0.25, 100, "ms"),
    "big_thread.after_scroll_footprint_mb": (0.10, 3, "MB"),
    "big_thread.after_scroll_peak_mb": (0.10, 5, "MB"),
    # Click to the first display refresh after the rows are placed; the refresh adds up to two frames of noise.
    "open.big_first_frame_ms": (0.25, 25, "ms"),
    "open.big_reopen_first_frame_ms": (0.25, 25, "ms"),
    "open.big_cache_first_frame_ms": (0.25, 25, "ms"),
    "stream.cpu_pct": (0.25, 1.0, "%"),
    "stream.interrupt_wakeups_per_s": (0.25, 5, "/s"),
    "stream.footprint_mb": (0.10, 3, "MB"),
    "stream.settled_footprint_mb": (0.10, 3, "MB"),
    "stream.peak_footprint_mb": (0.10, 5, "MB"),
    "size.bundle_mb": (0.10, 0.5, "MB"),
    "size.binary_mb": (0.10, 0.5, "MB"),
    "size.stripped_binary_mb": (0.10, 0.5, "MB"),
    "size.shipped_bundle_mb": (0.10, 0.5, "MB"),
}
BENCH_THRESHOLD = (0.20, 0.05, "ms")
# Reported but never a verdict: one sample each. The footprint 1 s after a turn lands is about 36-56 MB
# or about 86 MB in the same build: while a large view keeps redrawing, macOS draws it on the GPU and
# the process holds about 50 MB of GPU memory ("owned unmapped (graphics)" in vmmap) until redraws
# have stopped for about 5 s. stream.settled_footprint_mb, sampled 8 s after the turn, gates instead.
# Package idle wakeups follow the whole machine. stream.peak_footprint_mb and stream.cpu_pct gate.
INFORMATIONAL = {"stream.footprint_mb", "stream.package_idle_wakeups_per_s"}


def log(msg):
    print("perf-review: " + msg, file=sys.stderr, flush=True)


def run(cmd, **kw):
    return subprocess.run(cmd, check=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True, **kw).stdout


def git(*args, cwd=REPO):
    return run(["git", "-C", cwd] + list(args)).strip()


# MARK: build


def prepare_source(args):
    if args.source:
        src = os.path.abspath(args.source)
        sha = git("rev-parse", "--short=7", "HEAD", cwd=src)
        if git("status", "--porcelain", "--untracked-files=no", cwd=src) or git("ls-files", "--others", "--exclude-standard", cwd=src):
            sha += "-dirty"
        return src, sha
    sha = git("rev-parse", "--short=7", args.commit)
    src = "%s/src-%s" % (WORK, sha)
    if not os.path.isdir(src):
        log("worktree for %s at %s" % (sha, src))
        run(["git", "-C", REPO, "worktree", "add", "--detach", src, sha])
    return src, sha


def build_helpers():
    os.makedirs(BIN, exist_ok=True)
    for name in ("probe", "turn"):
        source, out = "%s/scripts/perf/%s.swift" % (REPO, name), "%s/%s" % (BIN, name)
        if not os.path.exists(out) or os.path.getmtime(out) < os.path.getmtime(source):
            run(["swiftc", "-O", source, "-o", out])


def build_app(src, sha):
    dd = "%s/dd-%s" % (WORK, sha)
    build_log = "%s/build-%s.log" % (WORK, sha)
    log("building Release app (log %s)" % build_log)
    with open(build_log, "w") as f:
        rc = subprocess.call(["xcodebuild", "-project", src + "/CandyWrapper.xcodeproj", "-scheme", "CandyWrapper",
                              "-configuration", "Release", "-derivedDataPath", dd, "PRODUCT_BUNDLE_IDENTIFIER=" + PERF_BUNDLE_ID, "build"],
                             stdout=f, stderr=subprocess.STDOUT)
    if rc != 0:
        sys.exit("perf-review: build failed, see " + build_log)
    return dd + "/Build/Products/Release/CandyWrapper.app"


def sizes(app):
    total = 0
    for root, _, files in os.walk(app):
        for name in files:
            path = os.path.join(root, name)
            if not os.path.islink(path):
                total += os.path.getsize(path)
    binary = app + "/Contents/MacOS/CandyWrapper"
    # What ships: `xcodebuild build` keeps the symbol tables that an archive strips. The spec's 25 MB budget is
    # for the shipped bundle, so measure a stripped copy too.
    stripped = WORK + "/stripped-binary"
    shutil.copy(binary, stripped)
    subprocess.call(["codesign", "--remove-signature", stripped], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.call(["strip", "-x", "-S", stripped], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    built, small = os.path.getsize(binary), os.path.getsize(stripped)
    os.remove(stripped)
    return {"size.bundle_mb": [total / 1048576], "size.binary_mb": [built / 1048576],
            "size.stripped_binary_mb": [small / 1048576], "size.shipped_bundle_mb": [(total - built + small) / 1048576]}


# MARK: micro-benchmarks


def benchmarks(src, wait_quiet_fn):
    target = src + "/Packages/CandyKit/Tests/FeaturesTests/PerfBenchmarks.swift"
    overlaid = False
    if not os.path.exists(target):
        # ponytail: copies today's benchmark file into older checkouts; breaks once the APIs it calls change, pin a copy per baseline then
        shutil.copy(REPO + "/Packages/CandyKit/Tests/FeaturesTests/PerfBenchmarks.swift", target)
        overlaid = True
    log("micro-benchmarks: release build of the package")
    flags = ["-c", "release", "-Xswiftc", "-enable-testing"]
    # Build first, then wait for a quiet machine (our own compile counts as busy), then measure.
    subprocess.run(["swift", "build", "--build-tests"] + flags, cwd=src + "/Packages/CandyKit",
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    wait_quiet_fn()
    log("micro-benchmarks: running")
    env = dict(os.environ, CW_BENCH="1")
    out = subprocess.run(["swift", "test"] + flags + ["--filter", "PerfBenchmarks"],
                         cwd=src + "/Packages/CandyKit", env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         universal_newlines=True).stdout
    results = {}
    for line in out.splitlines():
        m = re.search(r"PERF (\{.*\})", line)
        if m:
            b = json.loads(m.group(1))
            results["bench." + b["name"]] = b
    if not results:
        log("no benchmark output; tail:\n" + "\n".join(out.splitlines()[-15:]))
    return results, overlaid


# MARK: app runs


def foreign_apps(own=None):
    """CandyWrapper processes other than the user's demo app and our own."""
    demo = open(DEMO_PID_FILE).read().strip() if os.path.exists(DEMO_PID_FILE) else ""
    out = run(["ps", "-axo", "pid=,command="])
    pids = []
    for line in out.splitlines():
        pid, _, command = line.strip().partition(" ")
        executable = command.split(" ")[0]
        if executable.endswith("CandyWrapper.app/Contents/MacOS/CandyWrapper") and pid not in (demo, str(own)):
            pids.append(int(pid))
    return pids


def busy_processes():
    names = set()
    for line in run(["ps", "-axo", "comm="]).splitlines():
        name = os.path.basename(line.strip())
        if name in BUSY_PROCESSES:
            names.add(name)
    return sorted(names)


def wait_quiet(label, quiet, max_load, limit=600):
    """Waits until no compile or test process and no other CandyWrapper app runs and the 1-minute load
    average is under max_load, for at most limit seconds. Records the wait in quiet["waits"]."""
    start = time.time()
    load_before = os.getloadavg()[0]
    while True:
        busy, apps, load = busy_processes(), foreign_apps(), os.getloadavg()[0]
        if not busy and not apps and load < max_load:
            ok = True
            break
        if time.time() - start > limit:
            ok = False
            log("%s: machine not quiet after %d s (busy %s, apps %s, load %.2f); measuring anyway, run marked noisy"
                % (label, limit, busy, apps, load))
            break
        log("%s: waiting for a quiet machine (busy %s, apps %s, load %.2f)" % (label, busy, apps, load))
        time.sleep(10)
    entry = {"before": label, "waited_s": round(time.time() - start), "load_before": round(load_before, 2),
             "load": round(os.getloadavg()[0], 2), "quiet": ok}
    if not ok:
        entry.update(busy=busy, apps=apps)
        quiet["noisy"] = True
    quiet["waits"].append(entry)
    return ok


class PerfServer:
    """A T3 server of its own on a copy of the pristine dataset, with the env -i and detach pattern of
    scripts/sandbox-server. Stops only the PID it started, then deletes the copy."""

    def __init__(self):
        if not os.path.isdir(PRISTINE):
            sys.exit("perf-review: no perf dataset at %s; run scripts/perf-review --make-workload once" % PRISTINE)
        self.home = "%s/home-%d" % (WORK, os.getpid())
        self.pid = None

    def start(self):
        global SERVER
        shutil.rmtree(self.home, ignore_errors=True)
        shutil.copytree(PRISTINE, self.home, symlinks=True)
        s = socket.socket()
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
        s.close()
        version = open(REPO + "/T3_VERSION").read().strip().lstrip("v")
        binary = os.path.expanduser("~/.t3/runtime/versions/%s/t3" % version)
        home = os.environ["HOME"]
        # env -i: the shell inherits the live service's T3 variables, which would make this server try
        # to attach to the live service launcher.
        env = {"HOME": home, "USER": os.environ.get("USER", "mrm"), "LOGNAME": os.environ.get("USER", "mrm"),
               "SHELL": "/bin/zsh", "LANG": "en_US.UTF-8", "TMPDIR": os.environ.get("TMPDIR", "/tmp"),
               "PATH": home + "/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
               "T3CODE_TELEMETRY_ENABLED": "false", "T3CODE_HOME": self.home}
        self.proc = subprocess.Popen([binary, "serve", "--base-dir", self.home, "--port", str(port), "--host", "127.0.0.1", "--no-browser"],
                                     env=env, stdin=subprocess.DEVNULL, stdout=open(self.home + ".log", "wb"), stderr=subprocess.STDOUT,
                                     start_new_session=True, close_fds=True)
        self.pid = self.proc.pid
        open(WORK + "/server.pid", "w").write(str(self.pid))
        SERVER = "http://127.0.0.1:%d" % port
        log("perf server pid %d on %s, home %s" % (self.pid, SERVER, self.home))
        deadline = time.time() + 60
        # --max-time: a server still booting can accept the connection and never answer (seen once, 17 minutes).
        while subprocess.call(["curl", "-sf", "--max-time", "2", "-o", "/dev/null", SERVER + "/.well-known/t3/environment"]) != 0:
            if self.proc.poll() is not None or time.time() > deadline:
                self.stop()
                sys.exit("perf-review: the perf server did not start; see %s.log" % self.home)
            time.sleep(0.5)

    def stop(self):
        if self.pid:
            try:
                os.kill(self.pid, signal.SIGTERM)
                self.proc.wait(timeout=20)
            except ProcessLookupError:
                pass
            except subprocess.TimeoutExpired:
                os.kill(self.pid, signal.SIGKILL)
                self.proc.wait()
            self.pid = None
        shutil.rmtree(self.home, ignore_errors=True)


def make_workload():
    """Copies the sandbox home into PRISTINE: the SQLite database through .backup, so a running server
    can't tear it, and the rest as files, without the logs."""
    if os.path.exists(PRISTINE):
        sys.exit("perf-review: %s exists; move it away and bump WORKLOAD to make a new one" % PRISTINE)
    source = SANDBOX + "/t3home"
    skip = lambda d, names: [n for n in names if n.startswith("statev2.sqlite") or (n == "logs" and d.endswith("userdata"))]
    shutil.copytree(source, PRISTINE, symlinks=True, ignore=skip)
    os.makedirs(PRISTINE + "/userdata/logs")
    run(["sqlite3", source + "/userdata/statev2.sqlite", ".backup '%s/userdata/statev2.sqlite'" % PRISTINE])
    log("made %s, integrity %s" % (PRISTINE, run(["sqlite3", PRISTINE + "/userdata/statev2.sqlite", "pragma integrity_check"]).strip()))


def probe(*args):
    return [json.loads(l) for l in run([BIN + "/probe"] + [str(a) for a in args]).splitlines() if l.startswith("{")]


class App:
    def __init__(self, app_path, extra_args, tag, env_extra=None):
        self.log_path = "%s/app-%s.log" % (WORK, tag)
        before = open(PID_FILE).read().strip() if os.path.exists(PID_FILE) else ""
        subprocess.call(["defaults", "delete", PERF_BUNDLE_ID], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        env = dict(os.environ, CANDY_APP=app_path, CANDY_LAUNCH_TIMING="1", CANDY_THREAD_CACHE=PERF_THREAD_CACHE)
        env.update(env_extra or {})
        self.proc = subprocess.Popen([REPO + "/scripts/run-app", "--server", SERVER, "--token-file", TOKEN, "--fake-t3-connect"] + extra_args,
                                     env=env, stdout=open(self.log_path, "w"), stderr=subprocess.STDOUT, start_new_session=True)
        self.pid = None
        binary = app_path + "/Contents/MacOS/CandyWrapper"
        deadline = time.time() + 15
        while time.time() < deadline and self.pid is None:
            now = open(PID_FILE).read().strip() if os.path.exists(PID_FILE) else ""
            if now and now != before:
                command = subprocess.run(["ps", "-o", "command=", "-p", now], stdout=subprocess.PIPE, universal_newlines=True).stdout
                if binary in command:
                    self.pid = int(now)
            time.sleep(0.02)
        if self.pid is None:
            self.proc.kill()
            sys.exit("perf-review: the app did not start; see " + self.log_path)

    def timing(self, label, wait=0):
        deadline = time.time() + wait
        while True:
            m = re.search(r"launch-timing %s ([0-9.]+) s" % label, open(self.log_path).read())
            if m:
                return float(m.group(1)) * 1000
            if time.time() >= deadline:
                return None
            time.sleep(0.1)

    def rusage(self):
        return probe("rusage", self.pid)[0]

    def stop(self):
        # Only the PID this run launched and verified.
        try:
            os.kill(self.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        for _ in range(100):
            try:
                os.kill(self.pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)
        else:
            os.kill(self.pid, signal.SIGKILL)
        self.proc.wait()


def rates(a, b):
    seconds = (b["t_ns"] - a["t_ns"]) / 1e9
    return {"cpu_pct": (b["cpu_ns"] - a["cpu_ns"]) / 1e9 / seconds * 100,
            "interrupt_wakeups_per_s": (b["interrupt_wakeups"] - a["interrupt_wakeups"]) / seconds,
            "package_idle_wakeups_per_s": (b["idle_wakeups"] - a["idle_wakeups"]) / seconds}


def mb(n):
    return n / 1048576


def add(metrics, name, value):
    if value is not None:
        metrics.setdefault(name, []).append(value)


def scenario_idle(app_path, metrics, idle_seconds, i, noise):
    app = App(app_path, ["--open-thread", IDLE_THREAD], "idle-%d" % i)
    try:
        window = probe("window", app.pid, 30)[0]
        add(metrics, "launch.window_ms", window.get("ms"))
        add(metrics, "launch.live_sidebar_ms", app.timing("live sidebar", wait=20))
        add(metrics, "launch.cached_sidebar_ms", app.timing("cached sidebar"))
        time.sleep(5)  # settle: thread opened, first layout done
        a = app.rusage()
        time.sleep(idle_seconds)
        b = app.rusage()
        if foreign_apps(app.pid):
            noise.append("idle run %d overlapped another CandyWrapper app" % i)
        for k, v in rates(a, b).items():
            add(metrics, "idle." + k, v)
        add(metrics, "idle.footprint_mb", mb(b["footprint"]))
        add(metrics, "idle.peak_footprint_mb", mb(b["peak_footprint"]))
    finally:
        app.stop()


def scenario_big_thread(app_path, metrics, i, noise):
    # The app scrolls itself (--perf-scroll): events posted to its pid don't reach AppKit, and events
    # through the HID tap would move the user's pointer.
    app = App(app_path, ["--open-thread", BIG_THREAD, "--perf-scroll", "12"], "big-%d" % i)
    try:
        probe("window", app.pid, 30)
        app.timing("live sidebar", wait=20)
        time.sleep(8)  # the thread's history loads and lays out; scrolling starts 12 s after launch
        a = app.rusage()
        add(metrics, "big_thread.footprint_mb", mb(a["footprint"]))
        add(metrics, "big_thread.peak_footprint_mb", mb(a["peak_footprint"]))
        deadline = time.time() + 30
        while "perf-scroll done" not in open(app.log_path).read() and time.time() < deadline:
            time.sleep(0.1)
        if "perf-scroll done" not in open(app.log_path).read():
            noise.append("big-thread run %d: this build has no --perf-scroll, scroll numbers are idle numbers" % i)
        b = app.rusage()
        add(metrics, "big_thread.scroll_cpu_ms", (b["cpu_ns"] - a["cpu_ns"]) / 1e6)
        time.sleep(3)
        c = app.rusage()
        add(metrics, "big_thread.after_scroll_footprint_mb", mb(c["footprint"]))
        add(metrics, "big_thread.after_scroll_peak_mb", mb(c["peak_footprint"]))
        if foreign_apps(app.pid):
            noise.append("big-thread run %d overlapped another CandyWrapper app" % i)
    finally:
        app.stop()


def open_frames(app_path, tag, cache_dir, noise):
    # --perf-open: 4 s after the shell the app opens the big thread as a click would, 2 s later the
    # small one again, 2 s later the big one again (the second open comes from the retained store).
    # CANDY_THREAD_TIMING prints `thread-timing <ms> open <id>` and `... first frame ...` per open.
    # CANDY_THREAD_CACHE points the disk thread cache at our own directory (older builds ignore it).
    app = App(app_path, ["--open-thread", IDLE_THREAD, "--perf-open", "4", BIG_THREAD], tag,
              env_extra={"CANDY_THREAD_TIMING": "1", "CANDY_THREAD_CACHE": cache_dir})
    try:
        probe("window", app.pid, 30)
        app.timing("live sidebar", wait=20)
        deadline = time.time() + 20
        frames = []
        while time.time() < deadline:
            frames = re.findall(r"thread-timing\s+([0-9.]+) first frame", open(app.log_path).read())
            if len(frames) >= 4:
                break
            time.sleep(0.2)
        if len(frames) < 4:
            noise.append("%s: %d of 4 opens printed a first frame (no --perf-open in this build?)" % (tag, len(frames)))
        if foreign_apps(app.pid):
            noise.append("%s overlapped another CandyWrapper app" % tag)
        time.sleep(1)  # the cache writes the big thread 0.5 s after it settles and when its view closes
        return frames, app.log_path
    finally:
        app.stop()


def scenario_open(app_path, metrics, i, noise):
    # First launch with an empty thread cache: the big thread's first open comes from the network.
    # Second launch with what the first one cached: the same open paints from the disk cache.
    cache_dir = "%s/thread-cache-%d" % (WORK, i)
    shutil.rmtree(cache_dir, ignore_errors=True)
    # Opens in order: the small thread at launch, big, small, big again.
    frames, _ = open_frames(app_path, "open-%d" % i, cache_dir, noise)
    if len(frames) >= 4:
        add(metrics, "open.big_first_frame_ms", float(frames[1]))
        add(metrics, "open.big_reopen_first_frame_ms", float(frames[3]))
    frames, log_path = open_frames(app_path, "open-cached-%d" % i, cache_dir, noise)
    log_text = open(log_path).read()
    if "disk cache restored" not in log_text:
        noise.append("open-cached-%d: no open painted from the disk cache (a build without it?)" % i)
    elif len(frames) >= 2:
        add(metrics, "open.big_cache_first_frame_ms", float(frames[1]))
    shutil.rmtree(cache_dir, ignore_errors=True)


def scenario_stream(app_path, metrics, sha, noise):
    title = "Perf stream %s %s" % (sha, datetime.datetime.now().strftime("%H%M%S"))
    thread_id = run([BIN + "/turn", SERVER, TOKEN, "create", title]).strip().splitlines()[-1]
    app = App(app_path, ["--open-thread", title], "stream")
    try:
        probe("window", app.pid, 30)
        app.timing("live sidebar", wait=20)
        time.sleep(5)
        a = app.rusage()
        result = json.loads(run([BIN + "/turn", SERVER, TOKEN, "send", thread_id, STREAM_PROMPT]).strip().splitlines()[-1])
        time.sleep(1)  # the last events reach the app
        b = app.rusage()
        for k, v in rates(a, b).items():
            add(metrics, "stream." + k, v)
        add(metrics, "stream.footprint_mb", mb(b["footprint"]))
        add(metrics, "stream.peak_footprint_mb", mb(b["peak_footprint"]))
        time.sleep(7)  # macOS frees the GPU drawing memory about 5 s after the last redraw
        add(metrics, "stream.settled_footprint_mb", mb(app.rusage()["footprint"]))
        metrics["stream.turn"] = result
        if foreign_apps(app.pid):
            noise.append("stream run overlapped another CandyWrapper app")
    finally:
        app.stop()


# MARK: report


def summarize(values):
    return {"median": statistics.median(values), "min": min(values), "max": max(values), "values": values}


def verdict(name, new, old):
    rel, absolute, _ = THRESHOLDS.get(name, BENCH_THRESHOLD)
    if old is None:
        return "new"
    if name in INFORMATIONAL:
        return "info"
    delta = new["median"] - old["median"]
    big = abs(delta) > absolute and (old["median"] == 0 or abs(delta) / abs(old["median"]) > rel)
    if not big:
        return "same"
    if len(new.get("values", [])) >= 3 and len(old.get("values", [])) >= 3:
        if new["min"] <= old["max"] and old["min"] <= new["max"]:
            return "same (ranges overlap)"
    return "WORSE" if delta > 0 else "better"


def fmt(v):
    if v is None:
        return "-"
    return "%.3f" % v if abs(v) < 1 else "%.1f" % v


def table(result, baseline):
    rows = ["| Metric | This run | Range | Baseline | Delta | Verdict |", "|---|---|---|---|---|---|"]
    old_metrics = baseline["metrics"] if baseline else {}
    regressions = []
    for name, new in result["metrics"].items():
        if not isinstance(new, dict) or "median" not in new:
            continue
        old = old_metrics.get(name)
        v = verdict(name, new, old)
        if v == "WORSE":
            regressions.append(name)
        delta = "-" if old is None else ("%+.1f%%" % ((new["median"] - old["median"]) / old["median"] * 100) if old["median"] else fmt(new["median"] - old["median"]))
        spread = "%s to %s" % (fmt(new["min"]), fmt(new["max"])) if len(new.get("values", [])) > 1 or new.get("runs", 1) > 1 else ""
        rows.append("| %s | %s | %s | %s | %s | %s |" % (name, fmt(new["median"]), spread, fmt(old["median"]) if old else "-", delta, v))
    return "\n".join(rows), regressions


def latest_saved(out_dir, exclude):
    runs = []
    for path in glob.glob(out_dir + "/*.json"):
        if os.path.abspath(path) == os.path.abspath(exclude):
            continue
        try:
            data = json.load(open(path))
        except ValueError:
            continue
        # Runs on another workload (or the shared sandbox, before workloads) measured other threads.
        if data.get("workload") == WORKLOAD:
            runs.append((data.get("created", ""), path, data))
    if not runs:
        return (None, None)
    # Compare with the median of the last three runs, not the newest alone: on 2026-10-10 one
    # unusually low big-thread run (38 MB after scrolling, every other run 44) became the baseline
    # and made the next run look 16% worse. An A/B of both builds showed no change.
    recent = sorted(runs)[-3:]
    if len(recent) == 1:
        return recent[0][1:]
    metrics = {}
    for name in set().union(*(set(r[2].get("metrics", {})) for r in recent)):
        meds = [r[2]["metrics"][name]["median"] for r in recent
                if isinstance(r[2].get("metrics", {}).get(name), dict) and "median" in r[2]["metrics"][name]]
        if meds:
            metrics[name] = {"median": statistics.median(meds), "min": min(meds), "max": max(meds), "values": meds}
    return ("median of " + ", ".join(os.path.basename(r[1]) for r in recent), {"metrics": metrics})


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--commit", default="HEAD")
    p.add_argument("--source")
    p.add_argument("--baseline")
    p.add_argument("--repeat", type=int, default=3)
    p.add_argument("--idle-seconds", type=float, default=30)
    p.add_argument("--stream", action="store_true")
    p.add_argument("--no-bench", action="store_true")
    p.add_argument("--no-app", action="store_true")
    p.add_argument("--out-dir", default=REPO + "/docs/perf")
    # The M4 sits near 2 with the user's live T3 server and idle agents; a compile pushes it past 5.
    p.add_argument("--max-load", type=float, default=3.0, help="quiet means a 1-minute load average under this")
    p.add_argument("--make-workload", action="store_true")
    args = p.parse_args()
    if args.make_workload:
        make_workload()
        return

    os.makedirs(WORK, exist_ok=True)
    src, sha = prepare_source(args)
    build_helpers()
    noise = []
    raw = {}
    quiet = {"max_load": args.max_load, "noisy": False, "waits": []}
    result = {"commit": sha, "source": src, "created": datetime.datetime.now().isoformat(timespec="seconds"),
              "machine": run(["sysctl", "-n", "hw.model"]).strip(), "repeat": args.repeat, "idle_seconds": args.idle_seconds,
              "workload": WORKLOAD}

    if not args.no_app:
        app_path = build_app(src, sha)
        raw.update(sizes(app_path))
        server = PerfServer()
        quiet_wait = lambda label: wait_quiet(label, quiet, args.max_load)
        try:
            # Inside the try: an interrupt while the server boots must still stop it.
            server.start()
            for i in range(args.repeat):
                quiet_wait("idle-%d" % i)
                log("launch and idle, run %d of %d" % (i + 1, args.repeat))
                scenario_idle(app_path, raw, args.idle_seconds, i, noise)
            for i in range(args.repeat):
                quiet_wait("big-%d" % i)
                log("large thread, run %d of %d" % (i + 1, args.repeat))
                scenario_big_thread(app_path, raw, i, noise)
            for i in range(args.repeat):
                quiet_wait("open-%d" % i)
                log("thread open and reopen, run %d of %d" % (i + 1, args.repeat))
                scenario_open(app_path, raw, i, noise)
            if args.stream:
                quiet_wait("stream")
                log("streaming turn (one claude-haiku-5-5 turn)")
                scenario_stream(app_path, raw, sha, noise)
        finally:
            server.stop()
        result["load_average"] = os.getloadavg()

    metrics = {}
    for name, values in raw.items():
        metrics[name] = summarize(values) if isinstance(values, list) else values
    if not args.no_bench:
        benches, overlaid = benchmarks(src, lambda: wait_quiet("bench", quiet, args.max_load))
        for name, b in benches.items():
            metrics[name] = {"median": b["median_ms"], "min": b["min_ms"], "max": b["max_ms"], "runs": b["runs"],
                             "detail": {k: v for k, v in b.items() if k not in ("median_ms", "min_ms", "max_ms", "runs", "name")}}
        if overlaid:
            noise.append("micro-benchmarks: copied today's PerfBenchmarks.swift into this checkout")
    result["metrics"] = metrics
    result["quiet"] = quiet
    if quiet["noisy"]:
        noise.append("the machine was not quiet before every scenario within 10 minutes; see quiet.waits")
    result["notes"] = noise

    os.makedirs(args.out_dir, exist_ok=True)
    stem = "%s/%s-%s-w%d" % (args.out_dir, datetime.date.today().isoformat(), sha, WORKLOAD)
    if args.baseline:
        base_path, baseline = args.baseline, json.load(open(args.baseline))
        if baseline.get("workload") != WORKLOAD:
            noise.append("baseline %s ran workload %s, this run workload %d: the threads differ"
                         % (os.path.basename(base_path), baseline.get("workload"), WORKLOAD))
    else:
        base_path, baseline = latest_saved(args.out_dir, stem + ".json")
    result["baseline"] = os.path.basename(base_path) if base_path else None
    text, regressions = table(result, baseline)
    result["regressions"] = regressions
    json.dump(result, open(stem + ".json", "w"), indent=1, sort_keys=True)
    with open(stem + ".md", "w") as f:
        f.write("# Perf review %s\n\n" % sha)
        f.write("Run %s on %s, workload %d, %d launches per scenario, %d s idle window. Baseline: %s.%s\n\n"
                % (result["created"], result["machine"], WORKLOAD, args.repeat, args.idle_seconds, result["baseline"] or "none",
                   " NOISY: the machine did not get quiet." if quiet["noisy"] else ""))
        if quiet["waits"]:
            f.write("Quiet waits (s, 1-minute load when measuring started): %s\n\n"
                    % ", ".join("%s %d s, load %.2f%s" % (w["before"], w["waited_s"], w["load"], "" if w["quiet"] else " NOT QUIET")
                                for w in quiet["waits"]))
        f.write(text + "\n")
        if regressions:
            f.write("\nRegressions: %s\n" % ", ".join(regressions))
        for n in noise:
            f.write("\nNote: %s\n" % n)
    print(text)
    print("\nsaved %s.json and .md; baseline %s; regressions: %s" % (stem, result["baseline"] or "none", ", ".join(regressions) or "none"))


if __name__ == "__main__":
    main()
