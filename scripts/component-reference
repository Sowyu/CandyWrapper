#!/bin/sh
# Captures per-component reference PNGs from T3's markup and stylesheet in headless Chromium.
# Usage: scripts/component-reference [spec.json ...]   (default: every design/component-reference/*.json)
# The Button spec is generated by scripts/gen-button-spec.py.
set -eu
cd "$(dirname "$0")/.."
[ $# -eq 0 ] && set -- design/component-reference/*.json
for spec in "$@"; do swift scripts/component-reference.swift "$spec"; done
