#!/bin/zsh
# Builds, signs and publishes one CandyWrapper release from a commit (docs/release.md).
#
#   scripts/release [options] <commit>
#
#   --dry-run            do every local step, publish nothing
#   --notes FILE         release notes (markdown): the GitHub release body and the appcast item's description
#   --channel nightly    tag the appcast item `nightly` (only the Nightly track sees it); default: Sparkle's default channel
#   --out DIR            work folder, which must be yours (default: a new mktemp folder /tmp/cw-release-<version>.XXXXXX)
#
# Test builds only (scripts/release refuses to publish with any of these):
#   --appcast FILE       start from this appcast instead of the published one
#   --feed-url URL --public-key KEY --ed-key-file FILE --bundle-id ID --version X.Y.Z --build N
#   --download-prefix URL  the folder the appcast's enclosure points at, such as a local test server
#   --source DIR         build this checkout as it is (uncommitted work) in place of <commit>
#
# Secrets never reach argv or the log: the keychain password and the EdDSA seed go through stdin,
# the GitHub token stays inside the publisher's memory.
set -euo pipefail
umask 022 # the app and archives are public; no secret is ever written to a file here

REPO_SLUG=Sowyu/CandyWrapper
# The user's Apple Development certificate (free personal team) in the login keychain. A Team ID makes macOS
# key keychain items and privacy permissions to `teamid:` instead of each build's cdhash, so updates keep both.
IDENTITY="Apple Development"
TEAM=8Q677AYRU7
KC=$HOME/Library/Keychains/candywrapper-release.keychain-db
FEED_URL=https://github.com/$REPO_SLUG/releases/download/appcast/appcast.xml
here=${0:A:h:h}

dry=0 notes= channel= out= appcast_in= feed= pubkey= edfile= bundle_id= version= build= commit= source= dlprefix=
while (( $# )); do
  case $1 in
    --dry-run) dry=1 ;;
    --notes) notes=${2:A}; shift ;;
    --channel) channel=$2; shift ;;
    --out) out=$2; shift ;;
    --appcast) appcast_in=${2:A}; shift ;;
    --feed-url) feed=$2; shift ;;
    --public-key) pubkey=$2; shift ;;
    --ed-key-file) edfile=${2:A}; shift ;;
    --bundle-id) bundle_id=$2; shift ;;
    --version) version=$2; shift ;;
    --build) build=$2; shift ;;
    --source) source=${2:A}; shift ;;
    --download-prefix) dlprefix=$2; shift ;;
    -h|--help) sed -n '2,19p' $0; exit 0 ;;
    -*) print -u2 "unknown option $1"; exit 2 ;;
    *) commit=$1 ;;
  esac
  shift
done
[[ -n $commit || -n $source ]] || { print -u2 "usage: scripts/release [--dry-run] [--notes FILE] [--channel nightly] <commit>"; exit 2 }
[[ -z $channel || $channel == nightly ]] || { print -u2 "--channel takes only nightly"; exit 2 }
testing=0
[[ -n "$feed$pubkey$edfile$bundle_id$version$build$source$dlprefix$appcast_in" ]] && testing=1
if (( testing && !dry )); then print -u2 "test options need --dry-run"; exit 2; fi
if (( !dry )) && [[ -z $notes ]]; then print -u2 "--notes is required to publish"; exit 2; fi

if [[ -n $source ]]; then sha=$(git -C $source rev-parse HEAD); print "test build from $source (HEAD $sha plus local changes)"
else sha=$(git -C $here rev-parse --verify "$commit^{commit}"); print "release from $sha"; fi

# 1. Unlock the release keychain before anything reads it: a locked keychain opens a GUI dialog and waits.
unlock() {
  local pw=$(security find-generic-password -s dev.candywrapper.release-keychain -w)
  print -r -- "unlock-keychain -p $pw $KC" | security -i >/dev/null
}
unlock
# Anything running as this user can read the keychain's password, so keep it unlocked only while a
# release runs: auto-lock after 5 idle minutes or on sleep, and lock again on exit (trap below).
security set-keychain-settings -t 300 -l $KC

# 2. A clean worktree of the commit, removed on exit.
work=$(mktemp -d /tmp/cw-release-src.XXXXXX)
src=$work/src
if [[ -n $source ]]; then
  src=$source
  cleanup() { rm -rf $work }
else
  cleanup() { git -C $here worktree remove --force $src 2>/dev/null || true; rm -rf $work }
  git -C $here worktree add --detach $src $sha >/dev/null
fi
trap 'cleanup; security lock-keychain $KC 2>/dev/null' EXIT

# 3. Release build, arm64 only (CandyWrapper ships no Intel build).
dd=$work/dd
settings=(ARCHS=arm64 ONLY_ACTIVE_ARCH=NO)
[[ -n $feed ]] && settings+=("CANDY_UPDATE_FEED_URL=$feed")
[[ -n $pubkey ]] && settings+=("CANDY_UPDATE_PUBLIC_KEY=$pubkey")
[[ -n $bundle_id ]] && settings+=("PRODUCT_BUNDLE_IDENTIFIER=$bundle_id" "CANDY_URL_SCHEME=candywrapper-release-test")
[[ -n $version ]] && settings+=("MARKETING_VERSION=$version")
[[ -n $build ]] && settings+=("CURRENT_PROJECT_VERSION=$build")
print "building (log $work/build.log)"
xcodebuild -project $src/CandyWrapper.xcodeproj -scheme CandyWrapper -configuration Release -derivedDataPath $dd \
  "${settings[@]}" build > $work/build.log 2>&1 || { tail -30 $work/build.log; exit 1 }
built=$dd/Build/Products/Release/CandyWrapper.app
plist=$built/Contents/Info.plist
ver=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' $plist)
bnum=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' $plist)
minos=$(/usr/libexec/PlistBuddy -c 'Print :LSMinimumSystemVersion' $plist)
sparkle_bin=$dd/SourcePackages/artifacts/sparkle/Sparkle/bin
[[ -x $sparkle_bin/sign_update ]] || { print -u2 "Sparkle's sign_update is missing from $sparkle_bin"; exit 1 }

# A fresh private folder: a predictable /tmp path could be made by another account first and the app
# swapped between codesign and the zip. A given --out must belong to this user.
if [[ -z $out ]]; then out=$(mktemp -d /tmp/cw-release-$ver.XXXXXX)
else mkdir -p $out; [[ -O $out && ! -L $out ]] || { print -u2 "$out is not a folder owned by $USER"; exit 1 }; fi
rm -rf $out/CandyWrapper.app
ditto $built $out/CandyWrapper.app
app=$out/CandyWrapper.app
fw=$app/Contents/Frameworks/Sparkle.framework/Versions/B
print "version $ver ($bnum), out $out"

# 4. Strip the executable, thin Sparkle to arm64, then sign inside-out: Sparkle's helpers, the framework,
#    the app. No --deep: each piece gets the hardened runtime and this identity on its own.
strip -x -S $app/Contents/MacOS/CandyWrapper
for b in $fw/Sparkle $fw/Autoupdate $fw/Updater.app/Contents/MacOS/Updater; do
  lipo -archs $b | grep -q x86_64 && lipo -thin arm64 $b -output $b.thin && mv $b.thin $b
done
sign() { codesign --force --sign $IDENTITY --options runtime --timestamp=none "$@" }
sign $fw/Autoupdate
sign $fw/Updater.app
sign $fw
entitlements=()
[[ -f $src/App/Resources/CandyWrapper.entitlements ]] && entitlements=(--entitlements $src/App/Resources/CandyWrapper.entitlements)
sign "${entitlements[@]}" $app
codesign --verify --deep --strict $app
# Read codesign's output whole: with pipefail, grep -q closing the pipe early makes codesign fail on SIGPIPE.
signature=$(codesign -dv $app 2>&1)
[[ $signature == *$'\n'"TeamIdentifier=$TEAM"$'\n'* ]] || { print -u2 "the app is not signed by team $TEAM"; exit 1 }

# 5. The update archive (symlinks kept) and a DMG for first installs.
zip=CandyWrapper-$ver-arm64.zip
dmg=CandyWrapper-$ver-arm64.dmg
rm -f $out/$zip $out/$dmg
ditto -c -k --sequesterRsrc --keepParent $app $out/$zip
stage=$work/dmg
mkdir -p $stage
ditto $app $stage/CandyWrapper.app
ln -s /Applications $stage/Applications
hdiutil create -quiet -volname CandyWrapper -srcfolder $stage -fs HFS+ -format UDZO -ov $out/$dmg
codesign --force --sign $IDENTITY --timestamp=none $out/$dmg
shasum -a 256 $out/$zip $out/$dmg | sed "s|$out/||" > $out/sha256.txt

# 6. EdDSA: the archive, then the appcast. The seed goes to sign_update on stdin.
edkey() {
  if [[ -n $edfile ]]; then cat $edfile
  # Unlock again: the keychain locks after 5 idle minutes, and a build on a busy Mac takes longer than that.
  else unlock; security find-generic-password -s dev.candywrapper.sparkle-ed25519 -w $KC; fi
}
sig_line=$(edkey | $sparkle_bin/sign_update --ed-key-file - $out/$zip)
print -r -- "$sig_line" > $out/enclosure.txt

if [[ -n $appcast_in ]]; then cp $appcast_in $out/appcast.old.xml
# The query string skips GitHub's edge cache: a cached copy could be a stale feed, or a 404 from before the
# feed existed, and a fetch of the bare URL can itself leave such a 404 cached for every client.
elif ! curl -fsSL -o $out/appcast.old.xml "$FEED_URL?fetched=$(date +%s)"; then print "no published appcast yet, starting a new one"; rm -f $out/appcast.old.xml; fi
# Earlier items are copied into the new feed and signed again, so they must come from a feed this key signed.
if [[ -f $out/appcast.old.xml ]] && ! edkey | $sparkle_bin/sign_update --verify --ed-key-file - $out/appcast.old.xml >/dev/null 2>&1; then
  print -u2 "the published appcast's signature does not verify, so it changed outside scripts/release; stopping"; exit 1
fi

notes_file=${notes:-$work/notes.md}
[[ -n $notes ]] || print -r -- "- CandyWrapper $ver" > $notes_file
/usr/bin/python3 -I - $out $ver $bnum "$minos" "$channel" "$sig_line" $notes_file $zip $REPO_SLUG "$dlprefix" <<'PY'
import email.utils, html, os, re, sys, time
out, ver, build, minos, channel, sig_line, notes_file, zipname, repo, dlprefix = sys.argv[1:]
old = os.path.join(out, "appcast.old.xml")
items = []
if os.path.exists(old):
    text = open(old, encoding="utf-8").read()
    items = re.findall(r"<item>.*?</item>", text, flags=re.S)
def version_of(item):
    m = re.search(r"<sparkle:version>(.*?)</sparkle:version>", item)
    return m.group(1).strip() if m else "0"
if any(version_of(i) == build for i in items):
    sys.exit("the appcast already has build %s; raise CURRENT_PROJECT_VERSION in project.yml" % build)
sig = re.search(r'sparkle:edSignature="([^"]+)"', sig_line).group(1)
length = re.search(r'length="(\d+)"', sig_line).group(1)
notes = open(notes_file, encoding="utf-8").read().strip().replace("]]>", "]]]]><![CDATA[>")
tag = "v" + ver
download = dlprefix.rstrip("/") if dlprefix else "https://github.com/%s/releases/download/%s" % (repo, tag)
channel_line = "\n      <sparkle:channel>%s</sparkle:channel>" % channel if channel else ""
item = f"""<item>
      <title>{html.escape(ver)}</title>
      <pubDate>{email.utils.formatdate(time.time(), usegmt=True)}</pubDate>
      <sparkle:version>{html.escape(build)}</sparkle:version>
      <sparkle:shortVersionString>{html.escape(ver)}</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>{html.escape(minos)}</sparkle:minimumSystemVersion>
      <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>{channel_line}
      <link>https://github.com/{repo}/releases/tag/{tag}</link>
      <description><![CDATA[{notes}]]></description>
      <enclosure url="{download}/{zipname}" length="{length}" type="application/octet-stream" sparkle:edSignature="{sig}"/>
    </item>"""
def key(i):
    return [int(p) if p.isdigit() else 0 for p in re.split(r"[.\-]", version_of(i))]
items = sorted(items + [item], key=key, reverse=True)
feed = f"""<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>CandyWrapper</title>
    <link>https://github.com/{repo}/releases</link>
    {chr(10).join("    " + i if n else i for n, i in enumerate(items))}
  </channel>
</rss>
"""
open(os.path.join(out, "appcast.xml"), "w", encoding="utf-8").write(feed)
print("appcast: %d item(s)" % len(items))
PY
edkey | $sparkle_bin/sign_update --ed-key-file - $out/appcast.xml
grep -q 'sparkle-signatures' $out/appcast.xml || { print -u2 "the appcast is not signed"; exit 1 }
print "signed $out/appcast.xml"

if (( dry )); then
  print "dry run: nothing published. Artifacts in $out"
  exit 0
fi

# 7. Publish: the version release with the zip and the DMG, then the feed on the `appcast` release.
/usr/bin/python3 -I - $out $ver $sha $zip $dmg $notes_file "$channel" $REPO_SLUG <<'PY'
import hashlib, json, subprocess, sys, time, urllib.error, urllib.request
out, ver, sha, zipname, dmgname, notes_file, channel, repo = sys.argv[1:]
cred = subprocess.run(["git", "credential", "fill"], input="protocol=https\nhost=github.com\n\n",
                      capture_output=True, text=True, check=True).stdout
token = dict(l.split("=", 1) for l in cred.splitlines() if "=" in l)["password"]
api = "https://api.github.com/repos/" + repo
def call(url, data=None, ctype="application/json", method=None):
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", "Bearer " + token)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    if data is not None: req.add_header("Content-Type", ctype)
    with urllib.request.urlopen(req) as r:
        body = r.read()
        return json.loads(body) if body else None
def upload(release, name, ctype, as_name=None):
    as_name = as_name or name
    for a in release.get("assets", []):
        if a["name"] == as_name: call(api + "/releases/assets/%d" % a["id"], method="DELETE")
    data = open(out + "/" + name, "rb").read()
    asset = call("https://uploads.github.com/repos/%s/releases/%d/assets?name=%s" % (repo, release["id"], as_name), data, ctype)
    # A fresh asset can 404 for a few seconds until GitHub's download host sees it (v0.1.11's first run).
    for attempt in range(8):
        try:
            with urllib.request.urlopen(asset["browser_download_url"]) as r: got = r.read()
            break
        except urllib.error.HTTPError as e:
            if e.code != 404 or attempt == 7: raise
            time.sleep(2 + 2 * attempt)
    if hashlib.sha256(got).digest() != hashlib.sha256(data).digest(): sys.exit("download of %s does not match" % name)
    print("uploaded", asset["browser_download_url"])
    return asset
payload = {"tag_name": "v" + ver, "target_commitish": sha, "name": "CandyWrapper " + ver,
           "body": open(notes_file, encoding="utf-8").read(), "draft": False, "prerelease": channel == "nightly"}
try:
    rel = call(api + "/releases", json.dumps(payload).encode())
except urllib.error.HTTPError as e:
    if e.code != 422: raise
    rel = call(api + "/releases/tags/v" + ver)
    print("release v%s already exists, replacing its assets" % ver)
print("release", rel["html_url"])
upload(rel, zipname, "application/zip")
upload(rel, dmgname, "application/x-apple-diskimage")
try:
    feed = call(api + "/releases/tags/appcast")
except urllib.error.HTTPError as e:
    if e.code != 404: raise
    feed = call(api + "/releases", json.dumps({"tag_name": "appcast", "target_commitish": sha, "name": "Update feed",
        "body": "CandyWrapper's Sparkle appcast. scripts/release replaces appcast.xml here; keep this release.",
        "draft": False, "prerelease": True}).encode())
nxt = upload(feed, "appcast.xml", "application/xml", as_name="appcast-next.xml")
for a in feed.get("assets", []):
    if a["name"] == "appcast.xml": call(api + "/releases/assets/%d" % a["id"], method="DELETE")
call(api + "/releases/assets/%d" % nxt["id"], json.dumps({"name": "appcast.xml"}).encode(), method="PATCH")
data = open(out + "/appcast.xml", "rb").read()
with urllib.request.urlopen("https://github.com/%s/releases/download/appcast/appcast.xml?published=%d" % (repo, int(time.time()))) as r:
    if r.read() != data: sys.exit("the feed URL does not serve the new appcast")
print("feed", "https://github.com/%s/releases/download/appcast/appcast.xml" % repo)
PY
print "published $ver"
