#!/bin/sh
# Runs the Debug build in the GUI session against the sandbox T3 home. The app reuses the
# sandbox server if one runs (and asks to pair), else it starts and owns its own.
# `--live` uses ~/.t3 instead, as a Dock launch would. T3's service owns that home, so the app
# only joins its server, and pairing asks first.
# Other arguments go to the app: `--snapshot /tmp/x.png --snapshot-delay 12` renders the window
# to a PNG and quits. The app's pid goes to <app>.pid next to the app, and to /tmp/candywrapper-app.pid,
# which every run overwrites.
# CANDY_LAUNCH_TIMING=1, CANDY_THREAD_TIMING=1, CANDY_THREAD_CACHE (a directory, or `off`), CANDY_STALLS=1,
# CANDY_SIDEBAR_TIMING (1, or `nocache`), CANDY_THEME (a theme id), CANDY_ORCHESTRATOR=1 (the Orchestrator toggle on for that launch), CANDY_HELPER_MANIFEST (a helper-manifest.json for a test helper build) and CANDY_HELPER_TEST_HOME (installs it as a test helper with that home), CANDY_CONNECTORS_CONFIG_HOME (the home folder the Connectors tab edits, scripts/connectors-sandbox), CANDY_FAKE_LINEAGE (synthetic Lineage rows, Debug), CANDY_DEBUG_PENDING_PROVIDERS (pretend N provider updates wait, Debug), CANDY_IMAGE_TIMING=1, CANDY_RPC_TRACE (a file), CANDY_SLOW_LINK (`<rtt ms>:<Mbit/s>`), CANDY_WALLPAPER and CANDY_WALLPAPER_PLACEMENT (a test desktop picture for Glass, Debug) and MallocStackLogging (for `leaks --outputGraph`
# and `malloc_history -callTree`) in the caller's environment reach the app
# (scripts/perf-review).
# CANDY_T3_HOME picks another home than the sandbox's. CANDY_RUNTIMES points the app's own T3 runtimes
# at a folder (keep it under /tmp): the app then installs and updates runtimes there for real instead
# of running the `t3` linked below.
# Build first with scripts/build-test-app <task> and pass the path it prints in CANDY_APP.
# Usage: scripts/run-app [--live] [app arguments]
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
"$here/scripts/wait-origin"
version="$(sed 's/^v//' "$here/T3_VERSION")"
app="${CANDY_APP:-/tmp/cw-dd/Build/Products/Debug/CandyWrapper.app}"
bin=/tmp/candywrapper-bin
# Always the research folder in the home folder, from the main checkout and from any worktree.
research="$HOME/CandyWrapper-research"
home="CANDY_T3_HOME=${CANDY_T3_HOME:-$research/sandbox/t3home}"
if [ "${1-}" = "--live" ]; then
  shift
  # A harmless stand-in for the variable, so env still gets one NAME=VALUE argument.
  home="CANDY_LIVE=1"
fi
# The sandbox home has no runtime/service-state.json, so the app looks for t3 on PATH.
mkdir -p "$bin"
t3="$HOME/.t3/runtime/versions/$version/t3"
# A Nightly the live T3 hasn't installed comes unpacked from its GitHub release (docs/nightly-catch-up.md).
[ -x "$t3" ] || t3="$HOME/CandyWrapper-research/runtimes/t3-$version-darwin-arm64/t3"
ln -sf "$t3" "$bin/t3"
user="$(id -un)"
# launchctl asuser puts the app in the GUI session. env -i drops the live service's T3 variables.
exec sudo launchctl asuser "$(id -u)" sudo -u "$user" /bin/sh -c 'echo $$ > /tmp/candywrapper-app.pid; echo $$ > "$0"; exec "$@"' "$app.pid" \
  env -i HOME="$HOME" USER="$user" LOGNAME="$user" LANG=en_US.UTF-8 T3CODE_TELEMETRY_ENABLED=false \
  "$home" PATH="$bin:/usr/bin:/bin:/usr/sbin:/sbin" ${CANDY_LAUNCH_TIMING:+CANDY_LAUNCH_TIMING=1} ${CANDY_STALLS:+CANDY_STALLS=1} ${CANDY_THREAD_TIMING:+CANDY_THREAD_TIMING=1} \
  ${CANDY_THREAD_CACHE:+CANDY_THREAD_CACHE="$CANDY_THREAD_CACHE"} ${CANDY_SIDEBAR_TIMING:+CANDY_SIDEBAR_TIMING="$CANDY_SIDEBAR_TIMING"} ${CANDY_THEME:+CANDY_THEME="$CANDY_THEME"} ${CANDY_ORCHESTRATOR:+CANDY_ORCHESTRATOR="$CANDY_ORCHESTRATOR"} ${CANDY_HELPER_MANIFEST:+CANDY_HELPER_MANIFEST="$CANDY_HELPER_MANIFEST"} ${CANDY_HELPER_TEST_HOME:+CANDY_HELPER_TEST_HOME="$CANDY_HELPER_TEST_HOME"} ${CANDY_CONNECTORS_CONFIG_HOME:+CANDY_CONNECTORS_CONFIG_HOME="$CANDY_CONNECTORS_CONFIG_HOME"} ${CANDY_DEBUG_PENDING_PROVIDERS:+CANDY_DEBUG_PENDING_PROVIDERS="$CANDY_DEBUG_PENDING_PROVIDERS"} ${CANDY_FAKE_LINEAGE:+CANDY_FAKE_LINEAGE="$CANDY_FAKE_LINEAGE"} ${CANDY_RUNTIMES:+CANDY_RUNTIMES="$CANDY_RUNTIMES"} ${CANDY_IMAGE_TIMING:+CANDY_IMAGE_TIMING=1} ${CANDY_RPC_TRACE:+CANDY_RPC_TRACE="$CANDY_RPC_TRACE"} ${CANDY_SLOW_LINK:+CANDY_SLOW_LINK="$CANDY_SLOW_LINK"} ${CANDY_WALLPAPER:+CANDY_WALLPAPER="$CANDY_WALLPAPER"} ${CANDY_WALLPAPER_PLACEMENT:+CANDY_WALLPAPER_PLACEMENT="$CANDY_WALLPAPER_PLACEMENT"} ${MallocStackLogging:+MallocStackLogging="$MallocStackLogging"} \
  "$app/Contents/MacOS/CandyWrapper" "$@"
