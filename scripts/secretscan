#!/bin/zsh -f
# Exits 1 when commits would leak something private, 2 when it can't check. It reads each commit's
# author and committer e-mail, its message and its added lines (removing a leak never trips it).
# It blocks:
#  - this Mac's IP addresses (the public one is a local address here)
#  - keys and tokens
#  - e-mails other than GitHub noreply addresses or the approved public address
#  - AI attribution lines
#  - the user's private patterns: one extended regex per line in
#    $(git rev-parse --git-common-dir)/info/secret-patterns, kept out of the repo on purpose
# Usage: scripts/secretscan <rev-list arguments>, e.g. origin/main..HEAD. .githooks/pre-push runs it.
# ponytail: images aren't read; OCR them if screenshots of anything but sandbox data get committed
(( $# )) || { print -u2 "usage: scripts/secretscan <rev-list arguments>"; exit 2 }
file=$(git rev-parse --git-common-dir)/info/secret-patterns
[[ -r $file ]] || { print -u2 "secretscan: $file is missing; ask the user for the private patterns"; exit 2 }
private=${(j:|:)${(f)"$(grep -v -e '^#' -e '^[[:space:]]*$' $file)"}}
[[ -n $private ]] || { print -u2 "secretscan: $file holds no patterns"; exit 2 }
ips=(${(f)"$(/sbin/ifconfig | awk '/inet /{print $2}' | grep -v '^127\.')"})
(( $#ips )) || { print -u2 "secretscan: found no IP addresses to check"; exit 2 }
# Each pattern is written so it doesn't match its own text, or this file would trip the scan.
keys='gh[pousr]_|github_pa[t]_|sk-an[t]-|sk-[A-Za-z0-9]{20}|sk_liv[e]_|AKIA[0-9A-Z]{16}|xox[abprs]-|BEGIN [A-Z ]*PRIVATE KEY'
ai='^(Co-Authored-By|Generated with|🤖).*(Claude|Anthropic|Codex|OpenAI|GPT)'
approved='@users\.noreply\.github\.com$|^noreply@github\.com$|^anika@anikodev\.org$'

# grep -q on $1, except that a failing grep (a bad pattern) stops the scan instead of passing as no match.
has() { print -r -- "$1" | grep -q "${@[2,-1]}"; local s=$?; (( s > 1 )) && { print -u2 "secretscan: grep failed"; exit 2 }; return $s }

revs=$(git rev-list "$@") || exit 2
bad=0
for c in ${(f)revs}; do
  id=$(git log -1 --format='%h %s' $c)
  has "$(git log -1 --format='%ae%n%ce' $c)" -v -E -e "$approved" && { print -u2 "$id: author or committer e-mail is not approved"; bad=1 }
  msg=$(git log -1 --format=%B $c)
  has "$msg" -i -E -e "$ai" && { print -u2 "$id: AI attribution line in the message"; bad=1 }
  text=$msg$'\n'$(git show -U0 --no-color --format= $c | grep '^+' | grep -v '^+++ ')
  for ip in $ips; do has "$text" -F -e "$ip" && { print -u2 "$id: one of this Mac's IP addresses"; bad=1 }; done
  has "$text" -E -e "$keys" && { print -u2 "$id: something shaped like a key or token"; bad=1 }
  has "$text" -i -E -e "$private" && { print -u2 "$id: a private pattern from $file"; bad=1 }
done
(( bad )) && print -u2 "secretscan: rewrite those commits, then push again. Wrong e-mails: git rebase -x 'git commit --amend --no-edit --reset-author' origin/main"
exit $bad
