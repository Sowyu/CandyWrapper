#!/bin/sh
# Blocks a push whose new commits would leak something private (scripts/secretscan).
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin. Only commits that no
# remote-tracking branch has yet get checked, so old history never trips it.
status=0
while read -r _ sha _ _; do
  case "$sha" in *[!0]*) ;; *) continue ;; esac   # all zeros: a deletion sends no commits
  scripts/secretscan "$sha" --not --remotes || status=1
done
exit $status
