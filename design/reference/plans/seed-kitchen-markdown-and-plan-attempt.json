{
 "base": "http://127.0.0.1:47391",
 "width": 1100,
 "height": 780,
 "scale": 2,
 "themes": [
  "dark"
 ],
 "states": [
  {
   "name": "seed-kitchen2",
   "path": "/",
   "actions": [
    {
     "click": "[data-slot=popover-trigger]"
    },
    {
     "wait": 500
    },
    {
     "js": "document.querySelectorAll('[data-cap]').forEach(e=>e.removeAttribute('data-cap')); [...document.querySelectorAll(\"[role=option]\")].filter(e=>e.offsetParent!==null).find(e=>e.textContent.includes(\"Haiku 5.5\")).setAttribute('data-cap','1')"
    },
    {
     "click": "[data-cap=\"1\"]"
    },
    {
     "wait": 400
    },
    {
     "click": "[aria-label=\"Runtime mode\"]"
    },
    {
     "wait": 400
    },
    {
     "js": "document.querySelectorAll('[data-cap]').forEach(e=>e.removeAttribute('data-cap')); [...document.querySelectorAll(\"[role=option]\")].filter(e=>e.offsetParent!==null).find(e=>e.textContent.includes(\"Full access\")).setAttribute('data-cap','1')"
    },
    {
     "click": "[data-cap=\"1\"]"
    },
    {
     "wait": 400
    },
    {
     "click": ".composer-tiptap"
    },
    {
     "type": "Reply with markdown only, no tools. Include: an H1 and an H2 heading, a small table, a task list with checked and unchecked items, three short code blocks (python, typescript, bash), a GitHub alert written as > [!NOTE], and a bulleted list. Keep it brief."
    },
    {
     "wait": 300
    },
    {
     "key": "Enter"
    },
    {
     "wait": 25000
    },
    {
     "js": "location.pathname",
     "log": true
    }
   ]
  },
  {
   "name": "seed-plan",
   "path": "/",
   "actions": [
    {
     "click": "[data-slot=popover-trigger]"
    },
    {
     "wait": 500
    },
    {
     "js": "document.querySelectorAll('[data-cap]').forEach(e=>e.removeAttribute('data-cap')); [...document.querySelectorAll(\"[role=option]\")].filter(e=>e.offsetParent!==null).find(e=>e.textContent.includes(\"Haiku 5.5\")).setAttribute('data-cap','1')"
    },
    {
     "click": "[data-cap=\"1\"]"
    },
    {
     "wait": 400
    },
    {
     "click": "[aria-label=\"Runtime mode\"]"
    },
    {
     "wait": 400
    },
    {
     "js": "document.querySelectorAll('[data-cap]').forEach(e=>e.removeAttribute('data-cap')); [...document.querySelectorAll(\"[role=option]\")].filter(e=>e.offsetParent!==null).find(e=>e.textContent.includes(\"Full access\")).setAttribute('data-cap','1')"
    },
    {
     "click": "[data-cap=\"1\"]"
    },
    {
     "wait": 400
    },
    {
     "click": ".composer-tiptap"
    },
    {
     "type": "/plan"
    },
    {
     "wait": 600
    },
    {
     "key": "Enter"
    },
    {
     "wait": 500
    },
    {
     "type": "Plan a tiny change: add a --version flag to hello.py. Give a 4 step plan."
    },
    {
     "wait": 300
    },
    {
     "key": "Enter"
    },
    {
     "wait": 30000
    },
    {
     "js": "location.pathname",
     "log": true
    }
   ]
  }
 ]
}